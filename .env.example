# DoUpRo bootstrap configuration.
#
# Copy this file to `.env` and edit it. These are bootstrap-only values
# (require a restart to change) — everything else is configured at runtime
# from Settings in the web UI / API. See docs/settings.md for the full
# picture and SECURITY.md before touching anything below.

# --- Network -------------------------------------------------------------
DOUPRO_BIND_ADDR=:8080

# --- Storage ---------------------------------------------------------------
DOUPRO_DATA_DIR=/data
DOUPRO_DB_PATH=/data/doupro.db

# --- Docker ------------------------------------------------------------------
# Path to the Docker socket inside the container. You can specify:
# - a raw Unix socket path (e.g. /var/run/docker.sock)
# - a full URL with scheme: unix:///var/run/docker.sock or tcp://host:2375
# For production, prefer a socket-proxy (https://github.com/Tecnativa/docker-socket-proxy)
# or exposing the Docker API over TCP only with TLS + mutual auth (mTLS).
DOUPRO_DOCKER_SOCKET=/var/run/docker.sock

# A plain tcp:// Docker API without TLS is equivalent to giving remote root
# access to your host to anyone who can reach that port — see SECURITY.md.
# DoUpRo refuses to start with a tcp:// DOUPRO_DOCKER_SOCKET unless this is
# explicitly set to true, so an operator can't end up exposed by accident
# (e.g. a copy-pasted DOUPRO_DOCKER_SOCKET value nobody double-checked).
# Only set this if the tcp:// endpoint is genuinely trusted — reachable
# only over a private/loopback network, or itself TLS-terminated, e.g. a
# docker-socket-proxy on a Docker-internal network with no published port.
DOUPRO_ALLOW_INSECURE_DOCKER_TCP=false

# --- Local CLI socket ----------------------------------------------------------
# Unix socket the daemon also listens on for `docker exec doupro doupro ...`
# (see docs/cli.md) — no --host/--api-key needed there, since reaching this
# socket already requires being inside the container's mount namespace, the
# same trust level as the Docker socket above. Lives on the same volume as
# the database by default. Set to an empty value to disable it entirely.
DOUPRO_LOCAL_SOCKET=/data/doupro.sock

# --- Logging -----------------------------------------------------------------
DOUPRO_LOG_LEVEL=info

# --- Initial admin account ----------------------------------------------------
# Optional. Leave both unset for the zero-config default: an "admin" /
# "admin" account that DoUpRo forces you to change the password on before
# it lets you do anything else (see docs/settings.md, Security). Set both
# to skip that — a real password set here is trusted as-is and not forced
# to change. Setting only one of the two is an error (ambiguous).
#DOUPRO_ADMIN_USER=admin
#DOUPRO_ADMIN_PASSWORD=a-real-password-8-chars-or-more

# --- Reverse proxy ---------------------------------------------------------
# Set to true ONLY if a reverse proxy that terminates TLS (Traefik, nginx,
# Caddy, ...) sits directly in front of DoUpRo and is configured to strip
# any client-supplied X-Forwarded-Proto before setting its own. Without a
# real proxy doing that, this header is trivially spoofable by any client
# and must stay false — see auth.IsSecureRequest. Needed so the
# session/CSRF cookies' Secure flag is set correctly even though the
# connection DoUpRo itself sees is plain HTTP (the proxy already
# terminated the real HTTPS connection).
DOUPRO_TRUST_PROXY_HEADERS=false

# --- OIDC / SSO (Authentik, Keycloak, or any standard OIDC provider) -----------
# Optional. Leave DOUPRO_OIDC_ISSUER_URL unset to disable SSO entirely — the
# login page shows only the local username/password form, exactly like
# today. Setting it enables a "Sign in with SSO" button alongside (not
# instead of) local login, so the admin/admin (or configured) local account
# always remains a working fallback. If set, CLIENT_ID/CLIENT_SECRET/
# REDIRECT_URL must all be set too (see docs/settings.md, Security).
#DOUPRO_OIDC_ISSUER_URL=https://authentik.example.com/application/o/doupro/
#DOUPRO_OIDC_CLIENT_ID=doupro
#DOUPRO_OIDC_CLIENT_SECRET=change-me
# Must be an absolute URL matching exactly what's registered as the
# Redirect URI on the Authentik provider — DoUpRo can't safely derive this
# from the incoming request (see auth.IsSecureRequest's reasoning for why
# proxy-supplied headers aren't trusted by default).
#DOUPRO_OIDC_REDIRECT_URL=https://doupro.example.com/api/v1/auth/oidc/callback
# Optional. Comma-separated group names (Authentik's `groups` claim/scope
# mapping) — if set, only members of one of these groups can log in via
# SSO. Unset = any authenticated identity from the IdP is allowed, matching
# DoUpRo's current no-roles model (see docs/settings.md, Security).
#DOUPRO_OIDC_ALLOWED_GROUPS=doupro-admins
# Optional. Path to a PEM file (mount it in as a volume) containing an
# extra CA certificate to trust for OIDC discovery/token exchange calls —
# additive to the standard system CA bundle, never a replacement, and
# never a way to skip certificate verification. Needed if your IdP (e.g.
# an internal Authentik behind a self-signed or internal-CA certificate,
# common in homelab/on-prem setups) doesn't have a certificate issued by a
# CA already in the system trust store.
#DOUPRO_OIDC_EXTRA_CA_CERT_PATH=/certs/internal-ca.pem

# Optional additional CA bundle for every outbound HTTPS integration
# (self-hosted ntfy/Gotify/webhooks, private registries, etc.). The PEM is
# added to the system roots; certificate verification remains enabled.
# Mount the file read-only into the container first.
#DOUPRO_EXTRA_CA_CERT_PATH=/certs/internal-ca.pem

# --- Docker Hub credentials (optional, raises the anonymous rate limit) ------
# Optional. Authenticates every Docker Hub registry check and image pull as
# a real account instead of an anonymous one — Docker Hub's authenticated
# rate limit ceiling is substantially higher than the anonymous one, which
# a host tracking many containers can hit repeatedly (see docs/containers.md,
# "Docker Hub rate limiting"). Leave both unset to keep every request
# anonymous, exactly as before this existed. A Docker Hub Personal Access
# Token (hub.docker.com -> Account Settings -> Security -> Access Tokens,
# scoped to "Public Repo Read-only") is recommended over the account
# password itself — revocable independently, and never grants push/delete
# access even if leaked. Setting only one of the two is an error (ambiguous),
# same convention as DOUPRO_ADMIN_USER/PASSWORD above.
#DOUPRO_DOCKERHUB_USERNAME=your-dockerhub-username
#DOUPRO_DOCKERHUB_PASSWORD=a-personal-access-token-not-your-real-password

# --- Encryption at rest -----------------------------------------------------
# DoUpRo automatically creates /data/doupro.key (mode 0600) on first start
# and uses it to encrypt reversible SQLite secrets with AES-256-GCM. Back up
# this key with the database: encrypted settings cannot be recovered without it.
# A Docker secret can be mounted and selected instead:
#DOUPRO_ENCRYPTION_KEY_FILE=/run/secrets/doupro_encryption_key
# Or supply exactly 32 random bytes encoded as standard base64. Prefer *_FILE.
#DOUPRO_ENCRYPTION_KEY=<base64-encoded-32-byte-key>

# --- Docker socket group (Linux hosts) ----------------------------------------
# GID of the `docker` group on the host, so the non-root container user can
# reach the socket without the whole container running as root. Find it with:
#   getent group docker | cut -d: -f3
DOCKER_GID=999
